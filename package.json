{
  "name": "rss-to-issues",
  "version": "0.0.13",
  "description": "This action create issues from a syndication feed (RSS or Atom)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "prepare": "ncc build index.js -o dist --source-map",
    "test": "vitest run",
    "all": "npm run lint && npm run prepare && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-for-windows/rss-to-issues.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "RSS",
    "Atom"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/git-for-windows/rss-to-issues/issues"
  },
  "homepage": "https://github.com/git-for-windows/rss-to-issues#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "html-to-md": "^0.8.8",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^9.39.4",
    "neostandard": "^0.13.0",
    "vitest": "^4.1.5"
  }
}
